<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ass2.ass2_jfx.controller.multiplayerPlayController"
      VBox.vgrow="ALWAYS">

    <MenuBar style="-fx-background-color: #3a006f;">
        <Menu text="%file">
            <MenuItem text="%exit" onAction="#onExitClick"/>
        </Menu>
        <Menu text="%lookFeel">
            <MenuItem text="%dark" onAction="#onDarkClick"/>
            <MenuItem text="%light" onAction="#onLightClick"/>
        </Menu>
        <Menu text="%language">
            <MenuItem text="%english" onAction="#onENClick"/>
            <MenuItem text="%french" onAction="#onFRClick"/>
        </Menu>
    </MenuBar>

    <StackPane VBox.vgrow="ALWAYS">

        <ImageView fitHeight="100" fitWidth="100"
                   StackPane.alignment="TOP_CENTER"
                   preserveRatio="true">
            <StackPane.margin>
                <Insets top="10"/>
            </StackPane.margin>
            <Image url="@/ass2/ass2_jfx/WWTBAMUS2020Logo.png"/>
        </ImageView>

        <BorderPane>
            <padding>
                <Insets bottom="10" left="15" right="15" top="15"/>
            </padding>

            <!-- LEFT: Player info + lifelines -->
            <left>
                <VBox alignment="TOP_CENTER" prefWidth="250"
                      spacing="10" styleClass="side-panel">
                    <padding>
                        <Insets top="20" left="10" right="10"/>
                    </padding>

                    <Label fx:id="playerNameLabel"
                           text="Player"
                           style="-fx-font-size: 22px;"/>
                    <Label fx:id="playerMoneyLabel"
                           text="Money:"
                           style="-fx-font-size: 20px;"/>
                    <Label fx:id="playerMoneyAmountLabel"
                           text="\$0"
                           style="-fx-font-size: 20px;"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <VBox alignment="CENTER" spacing="8">
                        <padding>
                            <Insets bottom="20"/>
                        </padding>
                        <Label text="Lifelines"
                               style="-fx-font-size: 20px;"/>
                        <Button fx:id="fiftyFifty"
                                text="Superposition"
                                style="-fx-font-size: 16px;"
                                prefWidth="180" prefHeight="40"
                                onAction="#useSuperposition"/>
                        <Button fx:id="phoneAFriend"
                                text="Entanglement"
                                style="-fx-font-size: 16px;"
                                prefWidth="180" prefHeight="40"
                                onAction="#useEntanglement"/>
                        <Button fx:id="askTheAudience"
                                text="Interference"
                                style="-fx-font-size: 16px;"
                                prefWidth="180" prefHeight="40"
                                onAction="#useInterference"/>
                    </VBox>
                </VBox>
            </left>

            <!-- RIGHT: Scoreboard + Chat -->
            <right>
                <VBox prefWidth="280" spacing="8"
                      styleClass="side-panel">
                    <padding>
                        <Insets top="20" left="10" right="10"
                                bottom="10"/>
                    </padding>

                    <Label text="Scoreboard"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <ListView fx:id="scoreboardList"
                              prefHeight="200"
                              style="-fx-font-size: 14px;"/>

                    <Label fx:id="levelLabel" text="Level: 1"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Separator/>

                    <Label text="Chat"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <ListView fx:id="chatList"
                              prefHeight="150"
                              style="-fx-font-size: 13px;"/>
                    <HBox spacing="5">
                        <TextField fx:id="chatInput"
                                   promptText="Type a message..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-font-size: 14px;"/>
                        <Button fx:id="sendChatBtn" text="Send"
                                style="-fx-font-size: 14px;"
                                onAction="#onSendChat"/>
                    </HBox>
                </VBox>
            </right>

            <!-- CENTER: Question + Answers + Timer -->
            <center>
                <BorderPane>
                    <top>
                        <HBox alignment="TOP_RIGHT" spacing="10">
                            <Label fx:id="timerLabel" text="60"
                                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 10 20 0 0;"/>
                        </HBox>
                    </top>

                    <bottom>
                        <VBox spacing="10">
                            <GridPane alignment="BOTTOM_CENTER"
                                      hgap="15" vgap="10">
                                <padding>
                                    <Insets left="30" right="20"
                                            bottom="10"/>
                                </padding>

                                <Label fx:id="questionLabel"
                                       text="Waiting for question..."
                                       style="-fx-font-size: 22px; -fx-font-weight: bold;"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"
                                       GridPane.columnSpan="2"
                                       GridPane.halignment="CENTER"
                                       translateY="-20"/>

                                <Button fx:id="ansA" text="A"
                                        style="-fx-font-size: 20px;"
                                        prefWidth="280" prefHeight="55"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="1"
                                        onAction="#onAnswerClick"/>
                                <Button fx:id="ansB" text="B"
                                        style="-fx-font-size: 20px;"
                                        prefWidth="280" prefHeight="55"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1"
                                        onAction="#onAnswerClick"/>
                                <Button fx:id="ansC" text="C"
                                        style="-fx-font-size: 20px;"
                                        prefWidth="280" prefHeight="55"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="2"
                                        onAction="#onAnswerClick"/>
                                <Button fx:id="ansD" text="D"
                                        style="-fx-font-size: 20px;"
                                        prefWidth="280" prefHeight="55"
                                        maxWidth="Infinity"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="2"
                                        onAction="#onAnswerClick"/>
                            </GridPane>

                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="disconnectBtn"
                                        text="Disconnect"
                                        style="-fx-font-size: 18px;"
                                        prefWidth="200" prefHeight="50"
                                        onAction="#onDisconnect"/>
                            </HBox>
                        </VBox>
                    </bottom>
                </BorderPane>
            </center>
        </BorderPane>
    </StackPane>
</VBox>